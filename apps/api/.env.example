# --- Base de datos -----------------------------------------------------------
# Postgres. En Neon / Render copiar la "connection string" completa.
DATABASE_URL="postgresql://usuario:password@host:5432/desvios?sslmode=require"

# --- Autenticacion -----------------------------------------------------------
# Secretos de firma de los tokens. Generar con: openssl rand -hex 48
JWT_ACCESS_SECRET="cambiar-en-produccion-access"
JWT_REFRESH_SECRET="cambiar-en-produccion-refresh"
# Duracion del access token (corto) y del refresh token (largo).
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="7"

# --- Servidor ----------------------------------------------------------------
PORT="3001"
NODE_ENV="development"
# Origenes autorizados a consumir la API, separados por coma.
# En produccion: https://tu-proyecto.vercel.app
CORS_ORIGINS="http://localhost:5173"

# --- Modulo de analisis (IA) -------------------------------------------------
# "local"  -> responde con metricas calculadas sobre la base (default, sin credenciales)
# "openai" -> ChatGPT via la API de OpenAI (ver modules/analysis/openai.provider.ts)
# "codex"  -> delega en el motor Codex de la empresa (ver modules/analysis/codex.provider.ts)
AI_PROVIDER="local"
# Clave de OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=""
# Modelo de OpenAI. gpt-4o-mini es barato y rapido; gpt-4o o gpt-4.1 razonan mejor.
OPENAI_MODEL="gpt-4o-mini"
# Cuantos desvios recientes se le mandan al motor en cada pregunta.
AI_SAMPLE_SIZE=500
CODEX_API_URL=""
CODEX_API_KEY=""

# --- Seed --------------------------------------------------------------------
# Password de los usuarios demo que crea el seed.
SEED_PASSWORD="Demo1234!"
