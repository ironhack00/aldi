    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "dotenv": "16.4.5",
    "fastify": "4.28.1",
    "openai": "^7.45.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.8.6",
    "pino-pretty": "11.3.0",
